# HTTP server port
CURSUS_PORT=8080

# Log level: debug | info | warn | error
CURSUS_LOG_LEVEL=info

# How often to poll the GTFS-RT feeds
CURSUS_POLL_INTERVAL=30s

# Roma Mobilità GTFS-RT feed URLs
CURSUS_GTFS_TRIP_UPDATES_URL=https://romamobilita.it/sites/default/files/rome_rtgtfs_trip_updates.pb
CURSUS_GTFS_VEHICLE_POSITIONS_URL=https://romamobilita.it/sites/default/files/rome_rtgtfs_vehicle_positions.pb

# HTTP client timeout for each feed request
CURSUS_GTFS_FETCH_TIMEOUT=10s

# Max retry attempts before giving up on a poll cycle
CURSUS_GTFS_MAX_RETRIES=3

# Metro line route_id mappings (comma-separated)
# These must match the route_id values in the GTFS-RT feed.
# MB1 may appear as a distinct route_id or as a branch of MB.
CURSUS_METRO_ROUTE_IDS_MA=MA
CURSUS_METRO_ROUTE_IDS_MB=MB
CURSUS_METRO_ROUTE_IDS_MB1=MB1
CURSUS_METRO_ROUTE_IDS_MC=MC
